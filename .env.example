# ==========================================
# FlowTrack Environment Variables Template
# Copy this file to .env in local development
# ==========================================

# Environment
NODE_ENV=development
PORT=5000

# PostgreSQL Connection Strings
# Local Docker or Neon / Supabase URL:
DATABASE_URL="postgresql://flowtrack:flowtrack_secret_password@localhost:5432/flowtrack?schema=public"
# Direct URL used for Prisma migrations when using connection pooling:
DIRECT_URL="postgresql://flowtrack:flowtrack_secret_password@localhost:5432/flowtrack?schema=public"

# JWT Authentication Secrets
JWT_SECRET="flowtrack_super_secret_jwt_key_at_least_32_characters_long"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# CORS & Client URLs
CLIENT_URL="http://localhost:5173"
CORS_ORIGIN="http://localhost:5173"

# Frontend Vite Variables (apps/web/.env)
VITE_API_BASE_URL="http://localhost:5000/api/v1"
VITE_SOCKET_URL="http://localhost:5000"

# Object Storage (Supabase Storage or local disk fallback)
STORAGE_PROVIDER="local"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_BUCKET="flowtrack-attachments"
